-- XỬ LÝ HOẠT ẢNH & TÍNH NĂNG
-- ==============================
local Player = game:GetService("Players").LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Animate = Character:WaitForChild("Animate")
local DefaultAnims = {} -- Lưu lại hoạt ảnh gốc để khôi phục

-- Lưu trạng thái mặc định khi khởi động
for _, track in pairs({"idle", "walk", "run", "jump", "climb", "fall", "swim", "swimidle"}) do
    local anim = Animate:FindFirstChild(track)
    if anim then
        if track == "idle" then
            DefaultAnims.idle1 = anim.Animation1.AnimationId
            DefaultAnims.idle2 = anim.Animation2.AnimationId
        else
            DefaultAnims[track] = anim:FindFirstChildOfClass("Animation").AnimationId
        end
    end
end

-- Tự động áp dụng lại khi hồi sinh
Player.CharacterAdded:Connect(function(newChar)
    Character = newChar
    task.wait(1)
    Animate = Character:WaitForChild("Animate")
    -- Nếu đang có hoạt ảnh tùy chỉnh, giữ nguyên
    if _G.CurrentAnims then
        applyAnimSet(_G.CurrentAnims)
    end
end)

-- Hàm áp dụng bộ hoạt ảnh
function applyAnimSet(list)
    if list.idle1 then Animate.idle.Animation1.AnimationId = list.idle1 end
    if list.idle2 then Animate.idle.Animation2.AnimationId = list.idle2 end
    if list.walk then Animate.walk.WalkAnim.AnimationId = list.walk end
    if list.run then Animate.run.RunAnim.AnimationId = list.run end
    if list.jump then Animate.jump.JumpAnim.AnimationId = list.jump end
    if list.climb then Animate.climb.ClimbAnim.AnimationId = list.climb end
    if list.fall then Animate.fall.FallAnim.AnimationId = list.fall end
    if list.swim then Animate.swim.Swim.AnimationId = list.swim end
    if list.swimidle then Animate.swimidle.SwimIdle.AnimationId = list.swimidle end
    _G.CurrentAnims = list -- Lưu lại để giữ khi respawn
    Character.Humanoid.Jump = true -- Làm mới hoạt ảnh
end

-- Hàm tạo nút chọn hoạt ảnh
local function addAnimBtn(name, animList)
    local btn = Instance.new("TextButton")
    btn.BackgroundColor3 = Color3.fromHex("#2C2C33")
    btn.BackgroundTransparency = 0.2
    btn.CornerRadius = UDim.new(0, 8)
    btn.Font = Enum.Font.GothamMedium
    btn.Text = "• "..name
    btn.TextColor3 = Color3.fromHex("#E0E0E6")
    btn.TextSize = 14
    btn.MouseButton1Click:Connect(function() applyAnimSet(animList) end)
    btn.Parent = Scroll
end

-- Nút khôi phục mặc định
ResetBtn.MouseButton1Click:Connect(function()
    applyAnimSet(DefaultAnims)
    _G.CurrentAnims = nil
end)

