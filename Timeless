-- Helper to get all tools (char + backpack)
local function getAllTools()
    local tools = {}
    if plr.Character then
        for _, item in plr.Character:GetChildren() do
            if item:IsA("Tool") then table.insert(tools, item) end
        end
    end
    for _, item in plr.Backpack:GetChildren() do
        if item:IsA("Tool") then table.insert(tools, item) end
    end
    return tools
end

-- Biến lưu kích thước Reach hiện tại để tự áp dụng khi hồi sinh và quét Hitbox
local savedReachSize = 0
local savedInfectReach = 0

-- Hàm áp dụng Reach và hiệu ứng Highlight cho vũ khí Human
local function applyReachToTool(tool, size)
    if size <= 0 then return end
    for _, part in tool:GetDescendants() do
        if part:IsA("BasePart") and part:FindFirstChild("TouchInterest") then
            part.Size = Vector3.new(size, size, size)
            part.Transparency = 0.8 
            part.Massless = true
            
            if part:FindFirstChildOfClass("Highlight") then
                part:FindFirstChildOfClass("Highlight"):Destroy()
            end
            
            local highlight = Instance.new("Highlight", part)
            highlight.Adornee = part
            highlight.FillColor = Color3.fromRGB(0, 255, 255) 
            highlight.FillTransparency = 0.8
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.OutlineTransparency = 0.2
        end
    end
end

-- Hàm áp dụng Infect Reach khối hộp 3D cho Infected
local function applyInfectReach(n)
    if n <= 0 then return end
    local torso = plr.Character and plr.Character:FindFirstChild("Torso")
    if torso and torso:FindFirstChild("Part") then
        local p = torso.Part
        -- Tăng tầm vật lý ngầm
        p.Size = Vector3.new(7, 2, n)
        p.Massless = true
        p.Transparency = 1 
        
        -- Tạo khối hiển thị 3D sắc nét phía trước mặt
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            if hrp:FindFirstChild("BeautifulInfectVisual") then
                hrp.BeautifulInfectVisual:Destroy()
            end
            
            local container = Instance.new("Folder")
            container.Name = "BeautifulInfectVisual"
            container.Parent = hrp
            
            -- Tạo khối hộp đặc 3D thay vì tấm phẳng 2D
            local box = Instance.new("BoxHandleAdornment")
            box.Name = "VisualBox"
            box.Size = Vector3.new(7, 7, n) -- Chiều dài khối Z phủ hết tầm đánh n
            box.CFrame = CFrame.new(0, 0, -(n/2)) -- Căn tâm khối nằm chính giữa tầm đánh phía trước
            box.AlwaysOnTop = true
            box.ZIndex = 10
            box.Adornee = hrp
            box.Color3 = Color3.fromRGB(255, 40, 40) 
            box.Transparency = 0.85 -- Mờ nhẹ dễ nhìn xuyên qua
            box.Parent = container
            
            -- Khung viền 3D bao quanh khối hộp
            local border = Instance.new("SelectionBox")
            border.Name = "VisualBorder"
            border.Color3 = Color3.fromRGB(255, 40, 40)
            border.LineThickness = 0.03
            border.Adornee = box
            border.Parent = container
        end
    end
end

