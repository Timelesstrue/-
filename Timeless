-- SỬA LỖI CORE: Vòng lặp chờ nhân vật tải hoàn toàn để tự khôi phục Reach khi chết/biến hình
plr.CharacterAdded:Connect(function(char)
    -- Đợi cho đến khi cấu trúc cơ bản của Nhân vật xuất hiện
    char:WaitForChild("HumanoidRootPart", 5)
    
    -- Khôi phục Weapon Reach (Nếu là Human)
    if savedReachSize > 0 then
        task.wait(0.5)
        for _, tool in getAllTools() do
            applyReachToTool(tool, savedReachSize)
        end
    end

    -- Khôi phục Infect Reach (Nếu biến hình thành Infected)
    if savedInfectReach > 0 then
        task.spawn(function()
            local attempts = 0
            -- Vòng lặp liên tục kiểm tra xem game đã biến bạn thành Infected chưa (khi có Torso.Part)
            repeat 
                task.wait(0.2)
                attempts = attempts + 1
                if char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Part") then
                    applyInfectReach(savedInfectReach)
                    break
                end
            until attempts > 25 or savedInfectReach == 0 -- Chờ tối đa 5 giây hoặc dừng nếu đổi class
        end)
    end

    -- Theo dõi khi nhặt thêm vũ khí mới
    char.DescendantAdded:Connect(function(obj)
        if obj:IsA("Tool") and (autoReachNew or savedReachSize > 0) then
            task.wait(0.15)
            applyReachToTool(obj, savedReachSize)
        end
    end)
end)

