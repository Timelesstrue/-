--------------------------------------------------------------------
local function applyTargetHighlight(char)
    if not char:FindFirstChild("HitboxHighlight") then
        local hl = Instance.new("Highlight")
        hl.Name = "HitboxHighlight"
        hl.FillColor = Color3.fromRGB(255, 0, 0) 
        hl.FillTransparency = 0.5
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0
        hl.Adornee = char
        hl.Parent = char
    end
end

local function removeTargetHighlight(char)
    local hl = char:FindFirstChild("HitboxHighlight")
    if hl then hl:Destroy() end
end

task.spawn(function()
    while task.wait(0.1) do
        local myChar = plr.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        
        if myHrp then
            local isInfectedMode = (savedInfectReach > 0) and (myChar:FindFirstChild("Torso") and myChar.Torso:FindFirstChild("Part"))

            for _, targetPlr in game.Players:GetPlayers() do
                if targetPlr ~= plr and targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart") then
                    local targetChar = targetPlr.Character
                    local targetHrp = targetChar.HumanoidRootPart
                    local inHitbox = false

                    if isInfectedMode then
                        -- Quét vùng hình hộp chữ nhật trước mặt (Infected)
                        local relativePos = myHrp.CFrame:PointToObjectSpace(targetHrp.Position)
                        if math.abs(relativePos.X) <= 3.5 and math.abs(relativePos.Y) <= 3.5 and (relativePos.Z <= 0 and relativePos.Z >= -savedInfectReach) then
                            inHitbox = true
                        end
                    else
                        -- Quét vùng hình cầu xung quanh (Human Weapon Reach)
                        if savedReachSize > 0 then
                            local distance = (myHrp.Position - targetHrp.Position).Magnitude
                            if distance <= (savedReachSize / 2) then
                                inHitbox = true
                            end
                        end
                    end

                    if inHitbox then
                        applyTargetHighlight(targetChar)
                    else
                        removeTargetHighlight(targetChar)
                    end
                end
            end
        end
    end
end)
